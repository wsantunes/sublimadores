  "implementation_guidelines": {
    "universal_rules": [
      "DO NOT use gradients for backgrounds. Keep it flat and clean.",
      "Use 'Space Grotesk' for all Headings (H1-H3). Use 'Inter' for Body.",
      "Primary Color #00B4D8 is for ACTIONS only. Do not paint large surfaces with it.",
      "Sidebar should be collapsible on mobile.",
      "Gallery images must display aspect ratio correctly (object-contain or masonry).",
      "Use data-testid attributes for all interactive elements.",
      "Ensure text contrast ratio is > 4.5:1."
    ],
    "shadcn_customization": {
