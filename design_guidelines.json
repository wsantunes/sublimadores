    },
    "visual_enhancers": {
      "glassmorphism": "Used for sticky headers and overlays (backdrop-blur-md bg-white/80)",
      "borders": "Micro-borders (1px solid border-border) to define structure without heavy shadows",
      "shadows": "Subtle, diffuse ambient shadows for active elements only (shadow-sm)",
      "textures": "Noise texture overlay at 2% opacity on the main background to reduce digital sterility"
