    "motion": {
      "hover": "transform: translateY(-2px) transition-all duration-200 ease-out",
      "page_transition": "opacity-0 -> opacity-100 duration-300 ease-in-out",
      "modal_entrance": "scale-95 opacity-0 -> scale-100 opacity-100 duration-200 spring-physics"
    }
